# Werte erst nach Einrichtung eines echten Versandzugangs eintragen.
# Keine PUBLIC_-Variablen für Zugangsdaten verwenden.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Vom Mailanbieter bestätigte Absenderadresse (nicht die Besucheradresse).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sandro Mondini Website
# Leer = Sandros vorhandene Kontaktadresse aus src/data/portfolio.ts.
CONTACT_TO_EMAIL=
# Optional: öffentliche Website-Origin, z. B. https://www.example.com
# Mehrere Origins durch Komma trennen. Kein Pfad, kein abschließender Slash.
CONTACT_ALLOWED_ORIGINS=
