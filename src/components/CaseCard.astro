---
import MediaImage from './MediaImage.astro';
import { projects } from '../data/portfolio';
interface Props { project: typeof projects[number]; index?:number }
const {project,index=0}=Astro.props;
---
<a class:list={['case-card',{'case-card--offset':index%2===1}]} href={`/arbeiten/${project.slug}`}>
  <div class="case-card__image"><MediaImage image={project.cover} sizes="(max-width: 700px) 100vw, 47vw" /><span class="window-open" aria-hidden="true">↗</span></div>
  <div class="case-card__caption"><h3>{project.name}</h3><span>{project.category}</span></div>
</a>
