---
import MediaImage from './MediaImage.astro';
import { projects } from '../data/portfolio';
import '../styles/project-index.css';
const focus: Record<string, string> = { 'autohaus-heidrich': '50% 50%', kekila: '50% 35%', zixspeedracing: '50% 50%', kxxma: '50% 50%' };
// Use an existing landscape photograph for the wider stage tile.
const cover = (project: typeof projects[number]) => project.slug === 'kxxma' ? project.images.find(image => image.width > image.height) ?? project.cover : project.cover;
---
<div class="project-index" data-project-index>
  {projects.map(project => (
    <a class="project-index__item" href={`/arbeiten/${project.slug}`} aria-label={`${project.name}: Projekt ansehen`}>
      <div class="project-index__image">
        <MediaImage image={cover(project)} role="editorial" sizes="(max-width: 700px) 100vw, 50vw" position={focus[project.slug]} />
      </div>
      <div class="project-index__caption">
        <h3 class="project-index__roll">
          <span>{project.name}</span><span class="project-index__copy" aria-hidden="true">{project.name}</span>
        </h3>
        <p class="project-index__category">{project.category}</p>
        <span class="project-index__open">
          <span class="project-index__roll"><span>Projekt ansehen</span><span class="project-index__copy" aria-hidden="true">Projekt ansehen</span></span>
          <span class="project-index__arrow" aria-hidden="true">↗</span>
        </span>
      </div>
    </a>
  ))}
</div>
