---
import GalleryPhoto from './GalleryPhoto.astro';
import FilmCard from './FilmCard.astro';
import type {Photo,Film,Project} from '../data/portfolio';
interface Props { images:Photo[]; movies:Film[]; name:string; works?:Project['works'] }
const {images,movies,name,works=[]}=Astro.props;
import {justifyRows} from '../lib/justified-rows';
type Item={image?:Photo;movie?:Film;ratio:number};
// R4 (Sandro 18.11.): erst alle Fotos, Filme immer zuletzt, auch wenn später
// neue Bilder dazukommen. Beide Teile als Blocksatz-Reihen von Rand zu Rand.
const photoItems:Item[]=images.map(image=>({image,ratio:image.width/image.height}));
const filmItems:Item[]=movies.map(movie=>({movie,ratio:movie.width/movie.height}));
const items:Item[]=[...photoItems,...filmItems];
const rows=[...justifyRows(photoItems,item=>item.ratio),...justifyRows(filmItems,item=>item.ratio,{target:2.3,maxPerRow:4})];
const firstFilmRow=rows.findIndex(row=>row.items.some(item=>item.movie));
// Film-only collections use the same sheet: pairs of tall posters, one wide film.
const mobilePair=(index:number)=>{
  if(items[index].ratio>=1)return undefined;
  let start=index;
  while(start>0&&items[start-1].ratio<1&&!!items[start-1].movie===!!items[index].movie)start--;
  const partner=(index-start)%2===1?items[index-1]:items[index+1];
  return partner&&partner.ratio<1&&!!partner.movie===!!items[index].movie?Math.min(items[index].ratio,partner.ratio):undefined;
};
---
<div class="media-gallery" data-gallery aria-label={`Fotos und Filme: ${name}`}>
  {rows.map((row,rowIndex)=><div class:list={['media-gallery__row',`media-gallery__row--${row.fit}`,{'media-gallery__row--films-start':rowIndex===firstFilmRow&&rowIndex>0}]} style={`grid-template-columns:${row.items.map(item=>`minmax(0,${100*item.ratio/row.ratio}fr)`).join(' ')};--row-width:${row.width.toFixed(3)}%`}>
    {row.items.map(item=>{
      const index=items.indexOf(item);
      const pairRatio=mobilePair(index);
      const lastPortrait=index===items.length-1&&item.ratio<1;
      const halfWidth=pairRatio!==undefined||lastPortrait;
      const mobileSize=halfWidth?'calc((100vw - 51px) / 2)':'calc(100vw - 44px)';
      return <article id={item.image&&item.image===images[0]?'bilder':item.movie&&item.movie===movies[0]?'projekt-filme':undefined} class:list={['media-gallery__item',{'media-gallery__item--paired':pairRatio!==undefined,'media-gallery__item--half-width':halfWidth,'media-gallery__item--film':!!item.movie}]} style={pairRatio===undefined?undefined:`--mobile-preview-ratio:${pairRatio}`}>
        {item.image?<GalleryPhoto image={item.image} sizes={`(max-width: 700px) ${mobileSize}, (max-width: 1280px) ${(78*item.ratio/row.ratio*row.width/100).toFixed(2)}vw, ${Math.round(1080*item.ratio/row.ratio*row.width/100)}px`} eager={index<3} />:<FilmCard film={item.movie!} />}
      </article>;
    })}
  </div>)}
</div>
