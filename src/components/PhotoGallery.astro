---
import MediaImage from './MediaImage.astro';
import type { Photo } from '../data/portfolio';
interface Props { images:Photo[]; name:string; layout?:'grid'|'story' }
const { images,name,layout='grid' }=Astro.props;
const positions=[
  {column:'1 / span 5',row:1,offset:'7vw',size:'41vw'},
  {column:'6 / span 7',row:1,offset:'0px',size:'57vw'},
  {column:'2 / span 10',row:2,offset:'0px',size:'81vw'},
  {column:'1 / span 7',row:3,offset:'0px',size:'57vw'},
  {column:'8 / span 5',row:3,offset:'10vw',size:'41vw'},
  {column:'1 / -1',row:4,offset:'0px',size:'96vw'},
  {column:'1 / span 5',row:5,offset:'0px',size:'41vw'},
  {column:'6 / span 7',row:5,offset:'8vw',size:'57vw'},
];
---
<div class:list={['photo-gallery',{'photo-gallery--story':layout==='story'}]} data-gallery aria-label={name}>
  {images.map((image,i)=>{
    const slot=positions[i%positions.length];
    const single=i%8===2||i%8===5||i===images.length-1&&[0,3,6].includes(i%8);
    const portrait=image.height>image.width;
    const column=single?(portrait?'3 / span 8':'1 / -1'):slot.column;
    const size=single?(portrait?'65vw':'96vw'):slot.size;
    return <a class:list={['gallery-image',{'gallery-image--wide':image.width>image.height,'gallery-image--feature':layout==='grid'&&(i===3||i===8)}]} style={layout==='story'?`--story-column:${column};--story-row:${Math.floor(i/8)*5+slot.row};--story-offset:${single?'0px':slot.offset}`:undefined} href={image.display.at(-1)!.src} data-photo data-large={image.large.src} data-caption={image.alt} data-width={image.large.width} data-height={image.large.height} data-astro-reload aria-label={`${image.alt} – vergrößern`}>
      <MediaImage image={image} role={layout==='story'?'editorial':'preview'} sizes={layout==='story'?`(max-width: 700px) 94vw, ${size}`:'(max-width: 700px) 100vw, 48vw'} />
      <span class="gallery-enlarge" aria-hidden="true">↗</span>
    </a>;
  })}
</div>
