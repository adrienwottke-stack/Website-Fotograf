---
import { cutouts } from '../data/cutouts.generated.json';
interface Props {
  name: keyof typeof cutouts;
  sizes: string;
  alt?: string;
  class?: string;
  eager?: boolean;
}
const { name, sizes, alt, class:className, eager=false }=Astro.props;
const image=cutouts[name];
const fallback=image.variants[Math.min(1,image.variants.length-1)];
---
<img class:list={['cutout-image',className]} src={fallback.src} srcset={image.variants.map(variant=>`${variant.src} ${variant.width}w`).join(', ')} sizes={sizes} width={image.width} height={image.height} alt={alt??image.alt} loading={eager?'eager':'lazy'} decoding="async" />
<style>
  .cutout-image { display:block; width:100%; height:auto; object-fit:contain; background:transparent; }
</style>
