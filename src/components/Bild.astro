---
import { Image } from 'astro:assets';
import type { Bild } from '../data/bilder';

/**
 * Echtes Bild. Gleiche Schnittstelle wie <Frame>, damit Platzhalter 1:1
 * ersetzt werden können. Astro erzeugt AVIF/WebP in mehreren Größen.
 */
interface Props {
  bild: Bild;
  ratio?: string;
  zoom?: boolean;
  radius?: boolean;
  /** Nur für das erste Bild über dem Falz — lädt sofort statt lazy */
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  bild,
  ratio = '3 / 2',
  zoom = false,
  radius = true,
  eager = false,
  sizes = '(max-width: 760px) 100vw, (max-width: 1200px) 50vw, 33vw',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['bild', radius && 'bild--r', className]}
  style={`--ratio:${ratio}`}
>
  <Image
    src={bild.src}
    alt={bild.alt}
    widths={[400, 700, 1000, 1400]}
    sizes={sizes}
    format="avif"
    {/* Quelle ist bereits ein Instagram-Export, also selbst schon komprimiert.
        Höhere Qualität würde nur vorhandene Artefakte konservieren und Gewicht
        kosten. Mit den Originaldateien kann der Wert wieder hoch. */}
    quality={55}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
    class:list={['bild__img', zoom && 'bild__img--zoom']}
  />
</div>

<style>
  .bild {
    position: relative;
    /* Feste Proportion reserviert den Platz — kein Layoutsprung beim Laden */
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--sand);
    isolation: isolate;
  }

  .bild--r { border-radius: var(--r); }

  .bild__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-img) var(--ease);
  }

  /* Leichte Kante, damit helle Bilder auf Creme nicht ausfransen */
  .bild::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(36, 26, 18, 0.09);
  }
</style>
