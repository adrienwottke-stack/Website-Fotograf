---
import Base from '../layouts/Base.astro';
import Middlepage from './Middlepage.astro';
import MediaImage from './MediaImage.astro';
import PhotoGallery from './PhotoGallery.astro';
import FilmCard from './FilmCard.astro';

import MediaGallery from './MediaGallery.astro';
import { type Photo, type Film, type Project } from '../data/portfolio';
import '../styles/portfolio-gallery.css';

interface Props {
  name:string;
  subtitle:string;
  description:string;
  descriptionParagraphs?:string[];
  cover:Photo;
  backdrop?:Photo;
  backdropMode?:'fixed'|'scroll';
  backdropPosition?:string;
  images:Photo[];
  backHref:string;
  backLabel:string;
  next:{name:string;href:string;cover:Photo};
  movies?:Film[];
  filmHeading?:string;
  works?:Project['works'];
  tags?:string[];
  themeSlug?:string;
}
const {name,subtitle,description,descriptionParagraphs=[description],cover,backdrop=cover,backdropMode='fixed',backdropPosition='50% 50%',images,backHref,backLabel,next,movies=[],filmHeading='Filme',works=[],tags=[],themeSlug}=Astro.props;
const nextLabel=themeSlug?'Nächstes Thema':'Nächstes Projekt';
const photoComposition = ['tiere','events','reisen','autotreffen'].includes(themeSlug ?? '') ? 'tail' : 'classic';
const filmLayout = movies.length===1 ? (movies[0].width>movies[0].height?'landscape':'portrait') : movies.length===4 ? 'four' : movies.length===2 ? 'pair' : 'standard';
---
<Base title={name} description={description} gallery>
  <div class:list={['portfolio-backdrop', {'portfolio-backdrop--scroll':backdropMode==='scroll'}]} aria-hidden="true">
    <MediaImage image={backdrop} role="editorial" sizes="100vw" eager priority alt="" position={backdropPosition} />
  </div>
  <Middlepage enabled gallery>
    <header class="portfolio-hero">
      <a class="portfolio-back" href={backHref}><span aria-hidden="true">←</span> {backLabel}</a>
      <div class="portfolio-hero__title">
        <h1>{name}</h1>
        <div class="portfolio-hero__bottom"><p>{subtitle}</p><nav class="portfolio-media-links" aria-label="Medien dieser Sammlung">{images.length>0&&<a href="#bilder" class="portfolio-scroll">{images.length} {images.length===1?'Fotografie':'Fotografien'} <span aria-hidden="true">↓</span></a>}{movies.length>0&&<a href="#projekt-filme" class="portfolio-scroll">{movies.length} {movies.length===1?'Film':'Filme'} <span aria-hidden="true">↓</span></a>}</nav></div>
      </div>
    </header>
    <div class="portfolio-content">
      <div class="portfolio-intro"><div class="portfolio-intro__text">{descriptionParagraphs.map(paragraph=><p>{paragraph}</p>)}</div>{tags.length>0&&<ul aria-label="Projektbereiche">{tags.map(tag=><li>{tag}</li>)}</ul>}</div>
      {!themeSlug?<MediaGallery images={images} movies={movies} name={name} works={works} />:images.length>0&&<section id="bilder" aria-label={`Fotografien: ${name}`}><PhotoGallery images={images} name={`Bildstrecke ${name}`} layout="story" composition={photoComposition} /></section>}
    </div>
    {themeSlug&&movies.length>0&&<section id="projekt-filme" class="portfolio-film" aria-labelledby="portfolio-film-heading"><h2 id="portfolio-film-heading">{filmHeading}</h2><div class:list={['film-grid','portfolio-film__grid',`portfolio-film__grid--${filmLayout}`,{'portfolio-film__grid--weddings':themeSlug==='hochzeiten'}]}>{movies.map(movie=><FilmCard film={movie} />)}</div></section>}
    <section id="naechstes-thema" class="portfolio-outro" aria-label={nextLabel}>
      <a class="portfolio-next" href={next.href} aria-label={`${nextLabel}: ${next.name}`}>
        <div class="portfolio-next__preview"><MediaImage image={next.cover} sizes="(max-width: 700px) calc(100vw - 44px), (max-width: 1100px) 40vw, 480px" alt="" /></div>
        <div class="portfolio-next__copy">
          <span class="portfolio-next__label">{nextLabel}<span aria-hidden="true">↗</span></span>
          <h2>{next.name}</h2>
        </div>
      </a>
    </section>
  </Middlepage>
</Base>
