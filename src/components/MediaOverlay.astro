---
import ControlIcon from './ControlIcon.astro';
---
<dialog id="media-dialog" class="media-dialog" aria-labelledby="media-title">
  <div class="media-dialog__bar"><p id="media-title"></p><button type="button" class="icon-button" data-close-media aria-label="Großansicht schließen"><ControlIcon name="close" /></button></div>
  <div class="media-dialog__content" id="media-content"></div>
  <div class="media-dialog__bottom"><button type="button" class="icon-button" data-photo-prev aria-label="Vorheriges Foto"><ControlIcon name="left" /></button><p id="media-counter" aria-live="polite"></p><button type="button" class="icon-button" data-photo-next aria-label="Nächstes Foto"><ControlIcon name="right" /></button></div>
</dialog>
