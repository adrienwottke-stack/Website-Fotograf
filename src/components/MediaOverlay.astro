<dialog id="media-dialog" class="media-dialog" aria-labelledby="media-title">
  <div class="media-dialog__bar"><p id="media-title"></p><button class="icon-button" data-close-media aria-label="Großansicht schließen">×</button></div>
  <div class="media-dialog__content" id="media-content"></div>
  <div class="media-dialog__bottom"><button class="icon-button" data-photo-prev aria-label="Vorheriges Foto">←</button><p id="media-counter" aria-live="polite"></p><button class="icon-button" data-photo-next aria-label="Nächstes Foto">→</button></div>
</dialog>
