---
/**
 * Temporäre Leiste zum Vergleichen der Designrichtungen.
 * Sitzt ganz oben über der Seite und gilt auf allen Unterseiten.
 * Fliegt raus, sobald eine Richtung gewählt ist — dann wandern die
 * Token des Gewinners nach :root und dieses Bauteil wird gelöscht.
 */
export const themes = [
  { id: 'werkstatt',      nr: '1', name: 'Werkstatt',      kurz: 'Warm, hell, farbenfroh' },
  { id: 'postkarte',      nr: '2', name: 'Postkarte',      kurz: 'Laut, Typo dominiert' },
  { id: 'sonntagslicht',  nr: '3', name: 'Sonntagslicht',  kurz: 'Leise, viel Luft' },
  { id: 'abendwerkstatt', nr: '4', name: 'Abendwerkstatt', kurz: 'Warmes Dunkel, Kino' },
  { id: 'zeitung',        nr: '5', name: 'Zeitung',        kurz: 'Dicht, viele Spalten' },
  { id: 'nachtschicht',   nr: '6', name: 'Nachtschicht',   kurz: 'Blauschwarz, elektrisch' },
  { id: 'neonnacht',      nr: '7', name: 'Neonnacht',      kurz: 'Neon auf Violett' },
];
---

<div class="dw" id="dw">
  <div class="dw__in">
    <span class="dw__punkt" aria-hidden="true"></span>
    <span class="dw__titel">Designrichtung</span>

    <div class="dw__btns" role="group" aria-label="Designrichtung wählen">
      {themes.map((t) => (
        <button type="button" class="dw__b" data-theme-id={t.id} data-kurz={t.kurz} aria-pressed="false">
          <span class="dw__nr">{t.nr}</span>
          <span class="dw__name">{t.name}</span>
        </button>
      ))}
    </div>

    <span class="dw__kurz" id="dw-kurz"></span>
  </div>
</div>

<style>
  .dw {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 80;
    height: var(--dw-h);
    background: #14100D;
    color: #F5EDE3;
    border-bottom: 1px solid rgba(245, 237, 227, 0.18);
  }

  .dw__in {
    height: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dw__in::-webkit-scrollbar { display: none; }

  .dw__punkt {
    width: 12px; height: 12px;
    border-radius: 50%;
    flex: none;
    background: conic-gradient(from 200deg, #E8501F, #F5A524, #C4246B, #0D6E7A, #E8501F);
  }

  .dw__titel {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 237, 227, 0.6);
  }

  .dw__btns { display: flex; gap: 0.25rem; flex: none; }

  .dw__b {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    /* 36px reicht hier: reines Autorenwerkzeug, nicht Teil der Website */
    min-height: 34px;
    padding: 0 0.75em;
    border: 1px solid rgba(245, 237, 227, 0.24);
    border-radius: 999px;
    background: transparent;
    color: rgba(245, 237, 227, 0.75);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .dw__b:hover { color: #F5EDE3; border-color: rgba(245, 237, 227, 0.6); }

  .dw__b[aria-pressed='true'] {
    background: #D13F0E;
    border-color: #D13F0E;
    color: #fff;
  }

  .dw__nr { font-family: var(--font-mono); font-size: 0.6875rem; opacity: 0.75; }

  .dw__kurz {
    font-size: 0.8125rem;
    color: rgba(245, 237, 227, 0.6);
    white-space: nowrap;
    margin-left: auto;
    padding-left: 1rem;
  }

  @media (max-width: 900px) {
    .dw__titel, .dw__kurz { display: none; }
    .dw__b .dw__name { display: none; }
    .dw__b { min-width: 34px; justify-content: center; padding: 0 0.6em; }
  }

  @media print { .dw { display: none; } }
</style>
