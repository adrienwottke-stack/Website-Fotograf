---
const current=Astro.url.pathname;
const home=['/','/hero-2','/hero-2/'].includes(current)?'':'/';
const links=[[`${home}#projekte`,'Projekte'],['/leistungen','Leistungen'],['/ueber-mich','Über mich']];
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Sandro Mondini, Startseite">Sandro Mondini<span class="wordmark-dot" aria-hidden="true"></span></a>
  <nav class="desktop-nav" aria-label="Hauptnavigation">
    {links.map(([href,label])=><a href={href} aria-current={current.startsWith(href)?'page':undefined}>{label}</a>)}
    <a href="/kontakt" class="header-contact" aria-current={current==='/kontakt'?'page':undefined}>Lass uns sprechen <span aria-hidden="true">↗</span></a>
  </nav>
  <button class="menu-toggle icon-button" data-open-menu aria-controls="menu-dialog" aria-expanded="false" aria-label="Menü öffnen"><svg viewBox="0 0 24 24" width="25" height="25" fill="none" aria-hidden="true"><path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.6"/></svg></button>
</header>
<dialog id="menu-dialog" class="menu-dialog" aria-label="Navigation">
  <div class="menu-dialog__top"><span class="wordmark">Sandro Mondini</span><button class="icon-button" data-close-menu aria-label="Menü schließen">×</button></div>
  <nav aria-label="Mobile Hauptnavigation"><a href="/">Start</a>{links.map(([href,label])=><a href={href}>{label}</a>)}<a href="/kontakt">Kontakt <span aria-hidden="true">↗</span></a></nav>
  <p>Foto. Film. Deine Idee.</p>
</dialog>
