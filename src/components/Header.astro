---
import { verfuegbarkeit } from '../data/site';

const nav = [
  { href: '/arbeiten', text: 'Arbeiten' },
  { href: '/leistungen', text: 'Leistungen' },
  { href: '/ablauf', text: 'Ablauf' },
  { href: '/ueber-mich', text: 'Über mich' },
  { href: '/journal', text: 'Journal' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<a class="skip" href="#main">Zum Inhalt springen</a>

<header class="hd" id="hd">
  <div class="hd__in">
    <a class="hd__mark" href="/">
      <span class="hd__punkt" aria-hidden="true"></span>
      <span class="hd__txt">
        <span class="hd__name">Sandro Mondini</span>
        <span class="hd__role">Foto &amp; Film · Oberlausitz</span>
      </span>
    </a>

    <nav class="hd__nav" aria-label="Hauptnavigation">
      {nav.map((i) => (
        <a href={i.href} class:list={['hd__lnk', isActive(i.href) && 'is-active']}
           aria-current={isActive(i.href) ? 'page' : undefined}>{i.text}</a>
      ))}
    </nav>

    <div class="hd__end">
      <span class="hd__stat">
        <span class="hd__dot" aria-hidden="true"></span>{verfuegbarkeit.kurz}
      </span>
      <a href="/kontakt" class="btn hd__cta">Schreib mir</a>
      <button class="hd__burger" type="button" id="burger"
              aria-expanded="false" aria-controls="menu" aria-label="Menü öffnen">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" hidden>
  <nav class="menu__nav" aria-label="Navigation">
    {nav.map((i) => <a href={i.href} class="menu__lnk">{i.text}</a>)}
  </nav>
  <div class="menu__foot">
    <a href="/kontakt" class="btn">Schreib mir <span class="arw" aria-hidden="true">&rarr;</span></a>
    <p class="menu__stat"><span class="hd__dot" aria-hidden="true"></span>{verfuegbarkeit.lang}</p>
  </div>
</div>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    z-index: 100;
    background: var(--orange);
    color: #fff;
    padding: 0.75rem 1.25rem;
    border-radius: var(--r-pill);
    font-weight: 700;
  }
  .skip:focus { left: var(--gutter); top: calc(var(--dw-h) + 0.75rem); }

  .hd {
    position: fixed;
    inset: var(--dw-h) 0 auto 0;
    z-index: 50;
    transition: background-color 350ms var(--ease), box-shadow 350ms var(--ease);
  }

  .hd.is-stuck {
    background: rgba(255, 247, 237, 0.9);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--linie), 0 8px 30px rgba(36, 26, 18, 0.06);
  }

  .hd__in {
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--s-2) var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .hd__mark { display: flex; align-items: center; gap: 0.7rem; margin-right: auto; }

  .hd__punkt {
    width: 30px; height: 30px;
    border-radius: 50%;
    flex: none;
    background: conic-gradient(from 200deg, var(--orange), var(--gelb), var(--pink), var(--teal), var(--orange));
  }

  .hd__txt { display: grid; line-height: 1.2; }

  .hd__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hd__role {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .hd__nav { display: flex; gap: var(--s-1); }

  .hd__lnk {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-soft);
    padding: 0.5em 0.9em;
    border-radius: var(--r-pill);
    transition: color 220ms var(--ease), background-color 220ms var(--ease);
  }

  .hd__lnk:hover { color: var(--ink); background: var(--orange-weich); }
  .hd__lnk.is-active { color: var(--teal); background: var(--teal-weich); }

  .hd__end { display: flex; align-items: center; gap: var(--s-2); }

  .hd__stat {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .hd__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--gruen);
    box-shadow: 0 0 0 3px rgba(47, 122, 62, 0.18);
    flex: none;
  }

  .hd__cta { min-height: 42px; padding: 0.55em 1.3em; }

  .hd__burger {
    display: none;
    width: 48px; height: 48px;
    background: var(--weiss);
    border: 2px solid var(--linie-stark);
    border-radius: var(--r-pill);
    padding: 0;
    place-items: center;
    gap: 5px;
  }
  .hd__burger span {
    display: block;
    width: 18px; height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 300ms var(--ease);
  }
  .hd__burger[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .hd__burger[aria-expanded='true'] span:last-child  { transform: translateY(-3.5px) rotate(-45deg); }

  /* Vollbild-Overlay */
  .menu {
    position: fixed;
    inset: var(--dw-h) 0 0 0;
    z-index: 45;
    background: var(--creme);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-8);
    padding: var(--s-16) var(--gutter) var(--s-8);
  }
  .menu[hidden] { display: none; }

  .menu__nav { display: grid; gap: var(--s-1); }

  .menu__lnk {
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .menu__lnk:nth-child(2n) { color: var(--teal); }
  .menu__lnk:nth-child(3n) { color: var(--orange-tief); }

  .menu__foot { display: grid; gap: var(--s-3); justify-items: start; }

  .menu__stat {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    .hd__nav, .hd__stat, .hd__cta { display: none; }
    .hd__burger { display: grid; }
    .hd__role { display: none; }
  }
</style>
