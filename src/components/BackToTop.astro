<button type="button" class="back-to-top" data-back-to-top aria-label="Nach oben">
  <svg viewBox="0 0 24 24" width="23" height="23" fill="none" aria-hidden="true"><path d="M5 12 12 5l7 7M12 5v15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
</button>

<style>
  .back-to-top{position:fixed;right:calc(18px + env(safe-area-inset-right,0px));bottom:calc(var(--back-to-top-bottom,18px) + env(safe-area-inset-bottom,0px));z-index:50;display:grid;place-items:center;width:46px;height:46px;padding:0;border:1px solid #2a2f331a;border-radius:50%;background:#fff;color:#2a2f33;box-shadow:0 3px 14px #20252926;cursor:pointer}
  .back-to-top:hover{background:#fffdf6}
  .back-to-top:focus-visible{outline:3px solid #294b3d;outline-offset:4px}
  @media print{.back-to-top{display:none}}
</style>

<script>
  let controller: AbortController | undefined;
  let frame = 0;
  function initBackToTop() {
    controller?.abort();
    cancelAnimationFrame(frame);
    controller = new AbortController();
    const button=document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    button?.addEventListener('click', () => {
      window.scrollTo({ top:0, behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }, { signal:controller.signal });
    const controls=document.querySelector<HTMLElement>('.hero-ring-controls');
    if(controls && button){
      const signal = controller.signal;
      // A fixed offset can land on the arrow at different viewport heights.
      // Move above its actual row only while that row occupies the bottom edge.
      const placeButton = () => {
        frame = 0;
        const row = controls.getBoundingClientRect();
        const nearBottom = matchMedia('(max-width:700px)').matches &&
          row.top < innerHeight && row.bottom > innerHeight - 88;
        button.style.setProperty('--back-to-top-bottom', `${nearBottom ? Math.max(18, innerHeight - row.top + 12) : 18}px`);
      };
      const schedule = () => { if(!frame) frame=requestAnimationFrame(placeButton); };
      addEventListener('scroll', schedule, { passive:true, signal });
      addEventListener('resize', schedule, { passive:true, signal });
      document.fonts.ready.then(() => { if(!signal.aborted) schedule(); });
      placeButton();
    }
  }
  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
  document.addEventListener('astro:before-swap', () => {controller?.abort();cancelAnimationFrame(frame);frame=0;});
</script>
