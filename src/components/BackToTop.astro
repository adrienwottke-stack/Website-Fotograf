<button type="button" class="back-to-top" data-back-to-top aria-label="Nach oben">
  <svg viewBox="0 0 24 24" width="23" height="23" fill="none" aria-hidden="true"><path d="M5 12 12 5l7 7M12 5v15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
</button>

<style>
  .back-to-top{position:fixed;right:calc(18px + env(safe-area-inset-right,0px));bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:50;display:grid;place-items:center;width:46px;height:46px;padding:0;border:1px solid #2a2f331a;border-radius:50%;background:#fff;color:#2a2f33;box-shadow:0 3px 14px #20252926;cursor:pointer}
  .back-to-top:hover{background:#fffdf6}
  .back-to-top:focus-visible{outline:3px solid #294b3d;outline-offset:4px}
  /* Leave the mobile hero's next-photo control reachable beneath the button. */
  @media(max-width:700px){.back-to-top[data-above-hero-controls]{bottom:calc(84px + env(safe-area-inset-bottom,0px))}}
  @media print{.back-to-top{display:none}}
</style>

<script>
  let controller: AbortController | undefined;
  let observer: IntersectionObserver | undefined;
  function initBackToTop() {
    controller?.abort();
    observer?.disconnect();
    controller = new AbortController();
    const button=document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    button?.addEventListener('click', () => {
      window.scrollTo({ top:0, behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }, { signal:controller.signal });
    const controls=document.querySelector('.hero-ring-controls');
    if(controls && button){
      observer=new IntersectionObserver(entries=>button.toggleAttribute('data-above-hero-controls',entries[0].isIntersecting));
      observer.observe(controls);
    }
  }
  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
  document.addEventListener('astro:before-swap', () => {controller?.abort();observer?.disconnect();});
</script>
