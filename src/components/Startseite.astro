---
import ReviewPhoto from './ReviewPhoto.astro';
import '../styles/cutout-experiments.css';
import ThemeShowcase from './ThemeShowcase.astro';
import FilmSection from './FilmSection.astro';
import ProjectSection from './ProjectSection.astro';
import LogoMarquee from './LogoMarquee.astro';
import Testimonials from './Testimonials.astro';
import Header from './Header.astro';
import Middlepage from './Middlepage.astro';
import HeroStream from './HeroStream.astro';
import '../styles/hero-immersive.css';
import { services, photo } from '../data/portfolio';
interface Props { heroVariant?: 'trail' | 'stream' }
---
<HeroStream />
<Middlepage enabled>
  <div id="entdecken"><Header /></div>
  <section id="sandro" class="section about-teaser window-personal about-teaser--cutout"><div class="wrap about-teaser__inner"><div class="about-images"><div class="about-portrait"><ReviewPhoto group="story" choices={[{key:'portrait',cutout:'sandroPortrait'},{key:'sony-full',image:photo('1t5AGjwM4lwBSObAkSa9cLW93t_qbNmx5')},{key:'sony-cutout',cutout:'sonyFront'},{key:'camera',image:photo('1rL5il04tynMaFDDKgwjFBSfhUpKxgL7g')}]} sizes="(max-width:700px) 66vw, (max-width:900px) 430px, 34vw" /></div></div><div class="about-teaser__copy window-dark window-contour"><h2>Hey.<br />Ich bin<br />Sandro.</h2><p>Technik, Medien und kreative Ideen haben mich schon immer begeistert. Aus den ersten Projekten mit Freunden wurde mein eigener Weg mit Foto und Film.</p><a class="text-link" href="/ueber-mich">Meine Geschichte <span aria-hidden="true">↗</span></a></div></div></section>
  <ThemeShowcase />
  <FilmSection />
  <ProjectSection />
  <LogoMarquee />
  <Testimonials />
  <section id="leistungen" class="section section--butter home-services"><div class="wrap"><div class="section-heading"><h2>Was wir zusammen<br />machen können.</h2><p>Eine Idee, ein ganzer Dreh oder Unterstützung für dein Team.</p></div><div class="service-list">{services.map(service=><a class="service-row" href={`/leistungen#${service.id}`}><h3>{service.name}</h3><p>{service.text}</p><span aria-hidden="true">↗</span></a>)}</div></div></section>
</Middlepage>
