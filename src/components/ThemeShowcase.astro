---
import ThemeWindows from './ThemeWindows.astro';
import InteractiveBentoGallery from './ui/interactive-bento-gallery';
import InfinitePerspectiveSlider from './ui/infinite-perspective-slider';
import ZoomSlider from './ui/zoom-slider';
import HorizontalBentoGallery from './ui/bento-gallery';
import HaloReel from './ui/halo-reel';
import { themes } from '../data/portfolio';
const mediaItems = themes.map(theme => ({
  id:theme.slug,title:theme.name,desc:theme.note,href:`/arbeiten/themen/${theme.slug}`,photo:theme.cover,
  position:theme.slug==='people'?'50% 35%':theme.slug==='fahrzeuge'?'50% 40%':theme.slug==='hochzeiten'?'50% 35%':theme.slug==='reisen'?'50% 20%':'50% 50%',
}));
---
<section id="themen" class="section theme-section section--butter" data-theme-showcase>
  <div class="wrap">
    <div class="theme-showcase__top">
      <div class="section-heading"><h2>Worauf hast<br />du einen Blick?</h2><p>Menschen. Motoren. Mittendrin.<br />Such dir eine Welt aus.</p></div>
      <div class="theme-option-switch" role="tablist" aria-label="Gestaltung der Themenwelten">
        <button type="button" role="tab" id="themes-original-tab" aria-controls="themes-original" aria-selected="false" tabindex="-1" data-theme-option="original">Original</button>
        <button type="button" role="tab" id="themes-one-tab" aria-controls="themes-one" aria-selected="true" data-theme-option="1">Option 1</button>
        <button type="button" role="tab" id="themes-two-tab" aria-controls="themes-two" aria-selected="false" tabindex="-1" data-theme-option="2">Option 2</button>
        <button type="button" role="tab" id="themes-three-tab" aria-controls="themes-three" aria-selected="false" tabindex="-1" data-theme-option="3">Option 3</button>
        <button type="button" role="tab" id="themes-four-tab" aria-controls="themes-four" aria-selected="false" tabindex="-1" data-theme-option="4">Option 4</button>
        <button type="button" role="tab" id="themes-five-tab" aria-controls="themes-five" aria-selected="false" tabindex="-1" data-theme-option="5">Option 5</button>
      </div>
    </div>
    <div role="tabpanel" id="themes-original" aria-labelledby="themes-original-tab" data-theme-panel="original" hidden><ThemeWindows /></div>
    <div role="tabpanel" id="themes-one" aria-labelledby="themes-one-tab" data-theme-panel="1"><InteractiveBentoGallery mediaItems={mediaItems} client:visible /></div>
    <div role="tabpanel" id="themes-two" aria-labelledby="themes-two-tab" data-theme-panel="2" hidden><InfinitePerspectiveSlider images={mediaItems} client:visible /></div>
    <div role="tabpanel" id="themes-three" aria-labelledby="themes-three-tab" data-theme-panel="3" hidden><ZoomSlider sliderData={mediaItems} client:visible /></div>
    <div role="tabpanel" id="themes-four" aria-labelledby="themes-four-tab" data-theme-panel="4" hidden><HorizontalBentoGallery imageItems={mediaItems} client:visible /></div>
    <div role="tabpanel" id="themes-five" aria-labelledby="themes-five-tab" data-theme-panel="5" hidden><HaloReel items={mediaItems} client:visible /></div>
  </div>
</section>
<style>
  .theme-showcase__top{position:relative}
  .theme-showcase__top .section-heading{padding-right:0;padding-top:76px}
  .theme-option-switch{position:absolute;top:0;right:0;display:flex;gap:2px;padding:4px;border:1px solid var(--line);border-radius:32px;background:var(--paper)}
  .theme-option-switch button{min-height:44px;padding:0 18px;border-radius:28px;background:transparent;font-size:12px;font-weight:650}
  .theme-option-switch button[aria-selected="true"]{background:var(--ink);color:var(--paper)}
  @media(max-width:1000px){.theme-showcase__top .section-heading{padding-right:0;padding-top:76px}.theme-option-switch{left:0;right:auto}}
  @media(max-width:600px){.theme-option-switch{max-width:100%;gap:0;overflow-x:auto;border-radius:24px;scrollbar-width:none}.theme-option-switch button{flex-shrink:0;padding-inline:10px;font-size:11px}}
</style>
<script>
  let controller:AbortController|undefined;
  function initThemeOptions(){
    controller?.abort();controller=new AbortController();
    const root=document.querySelector<HTMLElement>('[data-theme-showcase]');if(!root)return;
    const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-theme-option]')];
    const panels=[...root.querySelectorAll<HTMLElement>('[data-theme-panel]')];
    const choose=(value:string,save=false)=>{
      const option=['original','1','2','3','4','5'].includes(value)?value:'1';
      root.dispatchEvent(new Event('theme:change'));
      tabs.forEach(tab=>{const active=tab.dataset.themeOption===option;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;});
      const selectedTab=tabs.find(tab=>tab.dataset.themeOption===option);
      if(selectedTab){const list=selectedTab.parentElement!;list.scrollLeft=Math.max(0,selectedTab.offsetLeft-(list.clientWidth-selectedTab.offsetWidth)/2);}
      panels.forEach(panel=>panel.hidden=panel.dataset.themePanel!==option);
      if(save){const url=new URL(location.href);url.searchParams.set('themen',option);history.replaceState(history.state,'',url);}
    };
    choose(new URL(location.href).searchParams.get('themen')||'1');
    tabs.forEach((tab,index)=>{
      tab.addEventListener('click',()=>choose(tab.dataset.themeOption!,true),{signal:controller!.signal});
      tab.addEventListener('keydown',event=>{
        if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;
        event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowLeft'?-1:1)+tabs.length)%tabs.length;
        tabs[next].focus();choose(tabs[next].dataset.themeOption!,true);
      },{signal:controller!.signal});
    });
  }
  initThemeOptions();document.addEventListener('astro:page-load',initThemeOptions);
  document.addEventListener('astro:before-swap',()=>controller?.abort());
</script>
