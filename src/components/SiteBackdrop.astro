---
import background from '../data/site-backdrop.generated.json';
import '../styles/site-bildraum.css';
interface Props { variant?: 'photo' | 'drawn' }
const { variant = 'photo' } = Astro.props;
const srcset = (variants: typeof background.landscape) => variants.map(image => `${image.src} ${image.width}w`).join(', ');
---
{variant === 'drawn' ? (
<div class="pilot-backdrop" aria-hidden="true">
  <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Original line drawing: loose viewfinder corners, loops and light marks.
           The supplied stock pattern remains a private reference only. -->
      <pattern id="mondini-linework" width="390" height="520" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="#526357" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity=".24">
          <path d="M35 63c34-35 60 47 89 14s-10-47 24-42M261 106c-19 32-2 72 35 65s33-54 5-58c-24-4-34 34-7 37" />
          <path d="M192 232l-6-35q-2-10 10-11l39-5M268 220l6 34q2 10-10 11l-38 5M32 352c38 1 11 59 41 60s6-44 38-44" />
          <path d="M252 397c13-31 25 15 40-12s18 23 34 3M141 471l19-17m-8 28 18-17M55 219l9 5m3-24 8 7M329 306l4 13m10-20 2 12" />
          <path d="M343 471c-7-13 9-24 20-14s-1 26-13 23" />
        </g>
        <g fill="#a39880" opacity=".28"><circle cx="188" cy="92" r="2"/><circle cx="111" cy="285" r="2.4"/><circle cx="222" cy="341" r="1.8"/><circle cx="24" cy="492" r="2"/></g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#mondini-linework)" />
  </svg>
</div>
) : (
<div class="site-backdrop" aria-hidden="true">
  <picture>
    <source media="(max-width: 700px)" srcset={srcset(background.portrait)} sizes="100vw" width={background.portrait[0].width} height={background.portrait[0].height} />
    <img src={background.landscape[0].src} srcset={srcset(background.landscape)} sizes="100vw" width={background.landscape[0].width} height={background.landscape[0].height} alt="" loading="eager" fetchpriority="auto" decoding="async" />
  </picture>
</div>
)}
