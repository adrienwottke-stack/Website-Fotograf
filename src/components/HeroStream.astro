---
import { ImageStreamHero } from './ui/image-stream-hero';
import { heroEntries } from '../data/hero-photos';
import HeroPhotoBrowse from './HeroPhotoBrowse.astro';
import '../styles/hero-immersive.css';

const images = heroEntries.map(({ image, href, themeSlug, themeName }) => ({
  src: image.preview.find(variant => variant.width >= 600)?.src ?? image.preview.at(-1)!.src,
  alt: image.alt, width: image.width, height: image.height,
  srcSet: image.preview.map(variant => `${variant.src} ${variant.width}w`).join(', '),
  avifSrcSet: image.avif?.map(variant => `${variant.src} ${variant.width}w`).join(', '),
  href, theme: themeName, themeSlug,
}));
---
<section class="stream-hero" aria-labelledby="stream-name" data-stream-hero>
  <header class="stream-hero__identity">
    <h1 id="stream-name" class="stream-hero__name"><span>Sandro</span> <span class="brand-terminal">Mondini</span></h1>
    <p>Foto und Film.</p>
  </header>
  <ImageStreamHero images={images} />
  <HeroPhotoBrowse mode="ring" total={images.length} firstTheme={images[0]?.theme} firstHref={images[0]?.href} />
  <a class="stream-hero__discover" href="#entdecken">Arbeiten entdecken <span aria-hidden="true">↓</span></a>
</section>

<noscript><style is:inline>
  .stream-hero { height:auto; }
  .stream-hero .hero-ring { height:auto; min-height:0; }
  .stream-hero .hero-ring__projection { perspective:none; }
  .stream-hero .hero-ring__space { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:18px; transform:none; padding:20px; }
  .stream-hero .hero-ring__card { position:static; width:100%; height:240px; transform:none; opacity:1; visibility:visible; pointer-events:auto; }
  .stream-hero .hero-ring-controls { display:none; }
</style></noscript>

<script>
  let controller: AbortController | undefined;

  function initHeroRings() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    document.querySelectorAll<HTMLElement>('[data-stream-hero]').forEach(hero => {
      const ring = hero.querySelector<HTMLElement>('[data-hero-ring]');
      const cards = [...hero.querySelectorAll<HTMLAnchorElement>('[data-ring-card]')];
      const caption = hero.querySelector<HTMLAnchorElement>('[data-ring-caption]');
      const count = hero.querySelector<HTMLElement>('[data-ring-count]');
      if (!ring || !cards.length || !caption || !count) return;

      // Unbounded signed position makes a last-to-first turn continuous.
      let position = 0;
      let suppressClick = false;
      let gesture: { id:number; x:number; y:number } | undefined;
      const mobile = matchMedia('(max-width: 700px)');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const selected = () => ((position % cards.length) + cards.length) % cards.length;

      const render = (announce = false) => {
        const current = selected();
        cards.forEach((card, index) => {
          const angle = (index - position) * 360 / cards.length;
          const depth = Math.cos(angle * Math.PI / 180);
          card.style.setProperty('--ring-angle', `${angle}deg`);
          card.style.setProperty('--ring-counter-angle', `${-angle}deg`);
          card.style.setProperty('--ring-opacity', String(.45 + (depth + 1) * .275));
          card.toggleAttribute('data-active', index === current);
          card.tabIndex = index === current ? 0 : -1;
          // Visible preview links remain exposed to assistive technology.
          // Arrow keys move the single card tab stop through the whole pool.
          card.setAttribute('aria-current', String(index === current));
        });
        const card = cards[current];
        caption.textContent = card.dataset.ringTheme!;
        caption.href = card.href;
        count.textContent = `${current + 1} / ${cards.length}`;
        hero.dataset.ringIndex = String(current);
        hero.toggleAttribute('data-ring-reduced', reduced.matches);
        if (announce) hero.dispatchEvent(new CustomEvent('hero-ring:change', {
          bubbles:true,
          detail:{ index:current, total:cards.length, theme:card.dataset.ringTheme, href:card.getAttribute('href') },
        }));
      };

      const move = (direction:number) => {
        const focusWasInCard = cards.some(card => card === document.activeElement);
        position += direction;
        render(true);
        if (focusWasInCard) cards[selected()].focus({ preventScroll:true });
      };

      hero.querySelectorAll<HTMLButtonElement>('[data-ring-step]').forEach(button => {
        button.addEventListener('click', () => move(Number(button.dataset.ringStep)), { signal });
      });
      hero.addEventListener('keydown', event => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          move(event.key === 'ArrowLeft' ? -1 : 1);
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          move((event.key === 'Home' ? 0 : cards.length - 1) - selected());
        }
      }, { signal });

      ring.addEventListener('pointerdown', event => {
        suppressClick = false;
        // A second touch belongs to native pinch zoom, not a pending swipe.
        if (!event.isPrimary) { gesture = undefined; return; }
        if (!mobile.matches || !event.isPrimary || event.pointerType === 'mouse') return;
        gesture = { id:event.pointerId, x:event.clientX, y:event.clientY };
      }, { signal });
      document.addEventListener('pointermove', event => {
        if (!gesture || gesture.id !== event.pointerId) return;
        const dx = Math.abs(event.clientX - gesture.x);
        const dy = Math.abs(event.clientY - gesture.y);
        // Once a gesture starts vertically, do not turn its eventual release
        // into a slide change, even if the finger later moves sideways.
        if (dy > 12 && dy > dx) gesture = undefined;
      }, { signal, passive:true });
      document.addEventListener('pointerup', event => {
        if (!gesture || gesture.id !== event.pointerId) return;
        const dx = event.clientX - gesture.x;
        const dy = event.clientY - gesture.y;
        gesture = undefined;
        if (Math.abs(dx) < 42 || Math.abs(dx) < Math.abs(dy) * 1.35) return;
        suppressClick = true;
        move(dx < 0 ? 1 : -1);
      }, { signal });
      document.addEventListener('pointercancel', event => {
        if (gesture?.id === event.pointerId) gesture = undefined;
      }, { signal });
      ring.addEventListener('click', event => {
        const prevent = suppressClick && event.detail > 0;
        suppressClick = false;
        if (prevent) event.preventDefault();
      }, { signal, capture:true });
      reduced.addEventListener('change', () => render(), { signal });
      mobile.addEventListener('change', () => { gesture = undefined; render(); }, { signal });

      render();
      hero.setAttribute('data-ring-ready', '');
    });
  }

  initHeroRings();
  document.addEventListener('astro:page-load', initHeroRings);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
