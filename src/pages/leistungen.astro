---
import Base from '../layouts/Base.astro';
import MediaImage from '../components/MediaImage.astro';
import ContactBanner from '../components/ContactBanner.astro';
import {services,faqs} from '../data/portfolio';
---
<Base title="Leistungen" description="Fotografie, Videografie, Postproduktion und Kameraarbeit. Sandro Mondini unterstützt dein kreatives Projekt – von der Bildidee bis zum Schnitt.">
  <div class="editorial-page editorial-page--services">
  <header class="wrap page-head page-head--split window-services-head"><h1>Deine Idee.<br />Mein Blick.</h1><div class="service-page-intro"><p class="lead">Fotoshootings, kurze und längere Filme oder Content Creation für dich und deine Marke.</p><p>Wir können gemeinsam etwas entwickeln. Oder ich unterstütze dein bestehendes Projekt mit Kameraarbeit, Schnitt und Bildbearbeitung. Was du brauchst, stimmen wir miteinander ab.</p><a class="text-link" href="/arbeiten/kekila">Foto und Social Content am Beispiel Kekila <span aria-hidden="true">↗</span></a></div></header>
  <div class="wrap">{services.map(service=><section id={service.id} class="service-detail window-service"><div class="service-detail__image"><MediaImage image={service.image} sizes="(max-width: 700px) 100vw, 43vw" /></div><div class="window-service__copy window-sheet"><h2>{service.name}</h2><p>{service.text}</p><ul>{service.items.map(item=><li>{item}</li>)}</ul><a class="text-link" href={`/kontakt?projekt=${encodeURIComponent(service.name)}`}>{service.name} anfragen <span aria-hidden="true">↗</span></a></div></section>)}</div>
  <section class="section section--butter"><div class="wrap"><div class="faq-layout"><h2>Gut zu<br />wissen.</h2><div class="faq-list">{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div><div class="price-note"><h2>Jedes Projekt ist anders.<br />Das Angebot auch.</h2><p>Deshalb findest du hier keine festen Pakete. Erzähl mir von deiner Idee, dem geplanten Umfang und den Rahmenbedingungen. Den Preis besprechen wir individuell.</p></div></div></section>
  <ContactBanner />
  </div>
</Base>

<style>
  .service-page-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; max-width: 48ch; }
  .service-page-intro > p:not(.lead) { font-size: 16px; line-height: 1.7; }
  .service-page-intro .text-link { min-height: 44px; line-height: 1.5; }
  @media(max-width:700px) { .service-page-intro { gap: 18px; } }
</style>
