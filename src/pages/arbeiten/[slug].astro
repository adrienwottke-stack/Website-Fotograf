---
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import Bild from '../../components/Bild.astro';
import { projekte } from '../../data/projekte';

export function getStaticPaths() {
  return projekte.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, naechstes: projekte[(i + 1) % projekte.length] },
  }));
}

const { p, naechstes } = Astro.props;

/* Echte Bildstrecke, falls vorhanden: die ersten drei bilden das Ergebnis,
   der Rest den Blick hinter die Kulissen. Sonst Farbverlauf-Platzhalter. */
const echtErgebnis = p.strecke?.slice(0, 3);
const echtUmsetzung = p.strecke?.slice(3);

/* Bildunterschriften erzählen, statt zu beschreiben (Konzept, Abschnitt 2, Ebene 3).
   PLATZHALTER — müssen von Sandro bestätigt werden (LIEFERLISTE.md, C3). */
const umsetzung = [
  { grade: 'sonne' as const, bu: '14:20 Uhr. Erst mal eine Runde gedreht und mit den Leuten geredet.' },
  { grade: 'petrol' as const, bu: 'Die Drohne durfte hoch, sobald die letzte Ausfahrt durch war.' },
];

const ergebnis = [
  { grade: p.grade, bu: 'Das Bild, auf das der ganze Tag hinauslief.' },
  { grade: 'gold' as const, bu: 'Detail am Heck — Lack, an dem jemand sehr lange gearbeitet hat.' },
  { grade: 'bluete' as const, bu: 'Letzte Aufnahme, kurz bevor alle eingepackt haben.' },
];
---

<Base title={p.titel} description={p.anriss}>
  <!-- Kopf -->
  <section class="ph">
    <div class="wrap">
      <p class="ph__krumen"><a href="/arbeiten">Arbeiten</a> <span aria-hidden="true">/</span> {p.kategorie}</p>
      <h1 class="ph__h">{p.titel}</h1>
      <p class="lead ph__lead">{p.anriss}</p>
      <p class="ph__meta">
        <span class="ph__chip">{p.kategorie}</span>
        <span>{p.kunde}</span><span aria-hidden="true">·</span>
        <span>{p.jahr}</span><span aria-hidden="true">·</span>
        <span>{p.leistung.join(' & ')}</span>
      </p>
    </div>

    <div class="wrap ph__bild" data-reveal>
      {p.bild
        ? <Bild bild={p.bild} ratio="16 / 9" eager sizes="100vw" />
        : <Frame grade={p.grade} ratio="16 / 9" label={`Aufmacher — ${p.titel}`} />}
    </div>
  </section>

  <!-- Akt 1 -->
  <section class="section akt">
    <div class="wrap akt__in">
      <div data-reveal>
        <p class="label label--orange">01 · Die Aufgabe</p>
        <p class="akt__gross">{p.anriss}</p>
      </div>
      <div class="prose akt__txt" data-reveal style="--reveal-delay:110ms">
        <p>{p.aufgabe ?? 'Projektbeschreibung folgt — siehe LIEFERLISTE.md, C1.'}</p>
      </div>
    </div>
  </section>

  <!-- Akt 2 -->
  <section class="section section--sand">
    <div class="wrap">
      <p class="label">02 · Die Umsetzung</p>
      <p class="lead akt2__lead" data-reveal>Der Teil, den sonst niemand zeigt.</p>

      <div class="paar">
        {echtUmsetzung
          ? echtUmsetzung.map((b, i) => (
              <figure class="fig" data-reveal style={`--reveal-delay:${i * 110}ms`}>
                <Bild bild={b} ratio="3 / 2" sizes="(max-width: 880px) 100vw, 50vw" />
                <figcaption class="fig__bu">{b.bu}</figcaption>
              </figure>
            ))
          : umsetzung.map((u, i) => (
              <figure class="fig" data-reveal style={`--reveal-delay:${i * 110}ms`}>
                <Frame grade={u.grade} ratio="3 / 2" label="Behind the Scenes" />
                <figcaption class="fig__bu">{u.bu}</figcaption>
              </figure>
            ))}
      </div>
    </div>
  </section>

  <!-- Akt 3 -->
  <section class="section">
    <div class="wrap">
      <p class="label label--pink">03 · Das Ergebnis</p>
    </div>

    <div class="strecke">
      {echtErgebnis
        ? echtErgebnis.map((b, i) => (
            <figure class="fig" data-reveal>
              <div class="wrap">
                <Bild bild={b} ratio={i === 0 ? '16 / 9' : '3 / 2'} sizes="100vw" />
                <figcaption class="fig__bu">{b.bu}</figcaption>
              </div>
            </figure>
          ))
        : ergebnis.map((e, i) => (
            <figure class="fig" data-reveal>
              <div class="wrap">
                <Frame grade={e.grade} ratio={i === 0 ? '16 / 9' : '3 / 2'} label={`Bild ${i + 1}`} />
                <figcaption class="fig__bu">{e.bu}</figcaption>
              </div>
            </figure>
          ))}
    </div>
  </section>

  <!-- Abspann -->
  <section class="section section--teal">
    <div class="wrap">
      <p class="label">Was drin war</p>
      <dl class="eck">
        <div><dt class="mono">Aufwand</dt><dd>{p.eckdaten?.drehtage ?? '—'}</dd></div>
        <div><dt class="mono">Umfang</dt><dd>{p.eckdaten?.umfang ?? '—'}</dd></div>
        <div><dt class="mono">Lieferzeit</dt><dd>{p.eckdaten?.lieferzeit ?? '—'}</dd></div>
        <div><dt class="mono">Leistung</dt><dd>{p.leistung.join(' & ')}</dd></div>
      </dl>

      <blockquote class="stimme" data-reveal>
        <p>Kundenstimme folgt.</p>
        <footer class="mono">Noch einzuholen — Lieferliste B1</footer>
      </blockquote>
    </div>
  </section>

  <!-- Nächstes -->
  <a class="next" href={`/arbeiten/${naechstes.slug}`}>
    <div class="wrap next__in">
      <span class="mono">Nächstes Projekt</span>
      <span class="next__h">{naechstes.titel}</span>
      <span class="next__arw" aria-hidden="true">&rarr;</span>
    </div>
  </a>
</Base>

<style>
  .ph { padding-block: calc(var(--section) + 3rem) 0; }

  .ph__krumen { font-size: var(--t-sm); color: var(--ink-soft); margin-bottom: var(--s-3); }
  .ph__krumen a { font-weight: 700; color: var(--teal); }
  .ph__krumen a:hover { color: var(--orange-tief); }

  .ph__h { font-size: var(--t-2xl); }
  .ph__lead { margin-top: var(--s-3); }

  .ph__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.6em;
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }

  .ph__chip {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    background: var(--teal-weich);
    border-radius: var(--r-pill);
    padding: 0.3em 0.85em;
  }

  .ph__bild { margin-top: var(--s-8); }

  /* --- Akte --- */
  .akt__in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: start;
  }
  @media (max-width: 880px) { .akt__in { grid-template-columns: 1fr; } }

  .akt__gross {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.16;
    text-wrap: balance;
  }
  .akt__txt p { color: var(--ink-soft); }

  .akt2__lead { margin-bottom: var(--s-8); }

  .paar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: var(--s-6) var(--s-4);
  }

  .fig { margin: 0; }
  .fig__bu {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .strecke { display: grid; gap: var(--s-8); }

  /* --- Abspann --- */
  .eck {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-8);
    padding-bottom: var(--s-8);
    border-bottom: 1px solid var(--linie);
  }
  .eck div { display: grid; gap: 0.3rem; }
  .eck dt { margin: 0; }
  .eck dd { margin: 0; font-family: var(--font-display); font-size: var(--t-lg); letter-spacing: -0.02em; }

  .stimme { margin: 0; max-width: 60ch; }
  .stimme p {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .stimme footer { margin-top: var(--s-2); }

  /* --- Nächstes --- */
  .next { display: block; background: var(--sand); }
  .next__in {
    display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-2) var(--s-3);
    padding-block: var(--s-12);
  }
  .next__h {
    font-family: var(--font-display);
    font-size: var(--t-xl); font-weight: 700; letter-spacing: -0.025em;
    margin-right: auto;
    transition: color 240ms var(--ease);
  }
  .next:hover .next__h { color: var(--orange-tief); }
  .next__arw { font-size: var(--t-xl); transition: transform 300ms var(--ease); }
  .next:hover .next__arw { transform: translateX(6px); }
</style>
