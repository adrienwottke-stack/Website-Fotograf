---
import PortfolioGallery from '../../components/PortfolioGallery.astro';
import { projects, film } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}
const { project, next } = Astro.props;
---
<PortfolioGallery
  name={project.name}
  subtitle={project.title}
  description={project.description}
  descriptionParagraphs={project.descriptionParagraphs}
  cover={project.cover}
  backdrop={project.cover}
  backdropMode="scroll"
  images={project.images}
  backHref="/projekte"
  backLabel="Alle Kunden und Projekte"
  next={{ name: next.name, href: `/arbeiten/${next.slug}`, cover: next.cover }}
  movies={project.filmKeys.map(film)}
  works={project.works}
  tags={project.tags}
/>
