---
import PortfolioGallery from '../../components/PortfolioGallery.astro';
import {projects,film} from '../../data/portfolio';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}));}
const {project,next}=Astro.props;
---
<PortfolioGallery name={project.name} subtitle={project.title} description={project.description} cover={project.cover} images={project.images} backHref="/#projekte" backLabel="Zurück zu den Projekten" next={{name:next.name,href:`/arbeiten/${next.slug}`,cover:next.cover}} movie={project.filmKey?film(project.filmKey):undefined} tags={project.tags} />
