---
import Base from '../../layouts/Base.astro';
import ProjektKarte from '../../components/ProjektKarte.astro';
import { projekte, kategorien } from '../../data/projekte';
---

<Base
  title="Arbeiten"
  description="Ausgewählte Foto- und Filmprojekte von Sandro Mondini — Fahrzeuge, Events, Unternehmen und Menschen in der Oberlausitz."
>
  <section class="kopf">
    <div class="wrap">
      <p class="label">Arbeiten</p>
      <h1 class="kopf__h">Lieber zwölf gute<br />als vierzig gemischte.</h1>
      <p class="lead kopf__lead">
        Eine Auswahl aus sechs Jahren. Was hier steht, durfte gezeigt werden — vieles andere nicht.
      </p>
    </div>
  </section>

  <section class="section section--top">
    <div class="wrap">
      <div class="filter" role="group" aria-label="Nach Anlass filtern">
        <button type="button" class="filter__b is-on" data-f="alle" aria-pressed="true">
          Alle <span class="filter__n">{projekte.length}</span>
        </button>
        {kategorien.map((k) => {
          const n = projekte.filter((p) => p.kategorie === k).length;
          return (
            <button type="button" class="filter__b" data-f={k} aria-pressed="false">
              {k} <span class="filter__n">{n}</span>
            </button>
          );
        })}
      </div>

      <p class="mono zaehler" role="status" id="zaehler">{projekte.length} Projekte</p>

      <div class="raster" id="raster">
        {projekte.map((p, i) => (
          <div class="zelle" data-k={p.kategorie}>
            <ProjektKarte p={p} delay={(i % 3) * 90} />
          </div>
        ))}
      </div>

      <p class="hinweis">
        Alle Einträge sind Platzhalter aus dem Instagram-Feed. Kundennamen, Jahreszahlen und
        Eckdaten werden vor dem Launch ersetzt.
      </p>
    </div>
  </section>
</Base>

<style>
  .kopf { padding-block: calc(var(--section) + 3.5rem) 0; }
  .kopf__h { font-size: var(--t-2xl); }
  .kopf__lead { margin-top: var(--s-4); }

  .section--top { padding-top: var(--s-8); }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .filter__b {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    background: var(--weiss);
    border: 2px solid var(--linie);
    border-radius: var(--r-pill);
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: var(--t-sm);
    font-weight: 700;
    /* 48px Mindesthöhe für Touch */
    min-height: 48px;
    padding: 0 1.3em;
    transition: border-color 220ms var(--ease), color 220ms var(--ease), background-color 220ms var(--ease);
  }

  .filter__b:hover { color: var(--ink); border-color: var(--linie-stark); }

  .filter__b.is-on {
    color: var(--weiss);
    border-color: var(--teal);
    background: var(--teal);
  }

  .filter__n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .zaehler { display: block; margin: var(--s-4) 0 var(--s-6); }

  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--raster-min)), 1fr));
    gap: var(--s-6) var(--s-4);
  }

  .zelle[hidden] { display: none; }

  .hinweis {
    margin-top: var(--s-12);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r);
    background: var(--orange-weich);
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 62ch;
  }
</style>

<script>
  const init = () => {
    const knoepfe = document.querySelectorAll<HTMLButtonElement>('.filter__b');
    const zellen = document.querySelectorAll<HTMLElement>('.zelle');
    const zaehler = document.getElementById('zaehler');
    if (!knoepfe.length) return;

    knoepfe.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.f;

        knoepfe.forEach((o) => {
          const on = o === b;
          o.classList.toggle('is-on', on);
          o.setAttribute('aria-pressed', String(on));
        });

        let sichtbar = 0;
        zellen.forEach((z) => {
          const zeigen = f === 'alle' || z.dataset.k === f;
          z.hidden = !zeigen;
          if (zeigen) sichtbar++;
        });

        if (zaehler) {
          zaehler.textContent = `${sichtbar} ${sichtbar === 1 ? 'Projekt' : 'Projekte'}`;
        }
      }),
    );
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
