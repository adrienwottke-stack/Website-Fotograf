---
import Base from '../layouts/Base.astro';
import Startseite from '../components/Startseite.astro';
import { themes } from '../components/DesignWahl.astro';

const beschreibung: Record<string, string> = {
  werkstatt: 'Cremefarbenes Papier, Orange, Petrol und Pink. Runde Formen, kräftige Grotesk. Offen und herzlich — der freundliche Handschlag.',
  postkarte: 'Sattes Rot und Blau auf Knallgelb, sehr große Rundungen, fette Schrift. Junge Energie — am nächsten an seiner Instagram-Handschrift.',
  sonntagslicht: 'Warme Serifen, Terrakotta und Salbei, viel Luft. Ruhiger und erwachsener; wirkt teuer, ohne kühl zu werden.',
  abendwerkstatt: 'Gebranntes Braun statt kaltem Schwarz, dazu Bernstein und Kupfer. Dunkel, aber gemütlich — Bilder leuchten am stärksten.',
  zeitung: 'Serifen-Schlagzeilen, harte Linien, ein Signalrot. Kein runder Winkel. Wirkt journalistisch und gemacht.',
};
---

<Base
  title="Fünf Designrichtungen"
  description="Fünf gestalterische Richtungen für die Website von Sandro Mondini — gleiche Struktur, gleicher Inhalt, unterschiedlicher Charakter."
>
  <section class="intro">
    <div class="wrap">
      <p class="label label--orange">Zur Auswahl</p>
      <h1 class="intro__h">Fünf Richtungen,<br />ein Inhalt.</h1>
      <p class="lead intro__lead">
        Unten rechts umschalten. Die Wahl gilt auf <b>allen</b> Seiten — klick dich also
        ruhig durch Arbeiten, Leistungen und Über mich, bevor du dich entscheidest.
      </p>

      <ol class="liste">
        {themes.map((t) => (
          <li class="liste__i">
            <span class="liste__nr">{t.nr}</span>
            <div>
              <h2 class="liste__h">{t.name}</h2>
              <p class="liste__kurz">{t.kurz}</p>
              <p class="liste__t">{beschreibung[t.id]}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="hinweis">
        Struktur und Texte sind in allen fünf identisch — es ändern sich Farbe, Schrift,
        Rundung und Rhythmus. Alle Farbpaare sind auf Lesbarkeit geprüft. Wo noch keine
        echten Fotos vorliegen, stehen Farbflächen, die die Bildstimmung andeuten.
      </p>
    </div>
  </section>

  <Startseite />
</Base>

<style>
  .intro { padding-block: calc(var(--section) + 3.5rem) var(--s-12); }
  .intro__h { font-size: var(--t-2xl); }
  .intro__lead { margin-top: var(--s-4); }

  .liste {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
    max-width: 76ch;
  }

  .liste__i {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--s-2);
    padding: var(--s-3);
    border-radius: var(--r);
    background: var(--weiss);
  }

  .liste__nr {
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--orange-tief);
  }

  .liste__h { font-size: var(--t-lg); }
  .liste__kurz { font-size: var(--t-sm); font-weight: 700; color: var(--teal); }
  .liste__t { margin-top: 0.35rem; font-size: var(--t-sm); color: var(--ink-soft); }

  .hinweis {
    margin-top: var(--s-6);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r);
    background: var(--sand);
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 76ch;
  }
</style>
