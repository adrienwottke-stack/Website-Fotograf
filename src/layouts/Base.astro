---
import '@fontsource-variable/archivo';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import '../styles/editorial-windows.css';
import '../styles/middlepage-pilot.css';
import '../styles/review-variants.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MediaOverlay from '../components/MediaOverlay.astro';
import SiteBackdrop from '../components/SiteBackdrop.astro';
import Middlepage from '../components/Middlepage.astro';
import ReviewControls from '../components/ReviewControls.astro';
import BackToTop from '../components/BackToTop.astro';
interface Props { title:string; description:string; gallery?:boolean }
const {title,description,gallery=false}=Astro.props;
const immersive = ['/', '/hero-2', '/hero-2/'].includes(Astro.url.pathname);
const windowKind = gallery ? 'gallery' : immersive ? 'home' : 'page';
const fullTitle=title==='Sandro Mondini – Foto & Film'?title:`${title} | Sandro Mondini`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Set colour and content choices before the first painted frame. The
      // bundled controller reuses this state throughout Astro navigation.
      (() => {
        // Astro keeps this object and the controller's listeners across swaps.
        if (window.__mondiniReview) return;
        const root = document.documentElement;
        const enabled = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname) || new URLSearchParams(location.search).get('vergleich') === '1';
        const defaults = { tone: 'light', films: 'three', story: 'portrait', about: 'portrait', expanded: false };
        const allowed = { tone: ['light', 'dark'], films: ['three', 'six'], story: ['portrait', 'sony-full', 'sony-cutout', 'camera'], about: ['portrait', 'sony-full', 'sony-cutout', 'camera', 'gimbal'] };
        let saved = {};
        try { saved = JSON.parse(sessionStorage.getItem('mondini-review-v1') || '{}') || {}; } catch {}
        const state = { ...defaults };
        for (const key of Object.keys(allowed)) if (allowed[key].includes(saved[key])) state[key] = saved[key];
        state.expanded = saved.expanded === true;
        window.__mondiniReview = { enabled, state };
        if (enabled) root.setAttribute('data-review-enabled', '');
        for (const key of Object.keys(allowed)) root.setAttribute('data-review-' + key, enabled ? state[key] : defaults[key]);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFFDF6" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <ClientRouter fallback="none" />
  </head>
  <body class:list={{'portfolio-page':gallery}} data-middlepage={windowKind}>
    <ReviewControls />
    {!gallery && <SiteBackdrop variant="drawn" />}
    <a class="skip-link" href="#inhalt">Zum Inhalt</a>
    {!immersive && <Header />}
    <main id="inhalt" tabindex="-1" transition:animate="none"><Middlepage enabled={!immersive && !gallery}><slot /></Middlepage></main>
    <Footer pilot />
    <BackToTop />
    <MediaOverlay />
    <script>import '../scripts/site';</script>
    <script>import '../scripts/review-controls';</script>
  </body>
</html>

<style is:global>
  html { color-scheme:light; }
</style>
