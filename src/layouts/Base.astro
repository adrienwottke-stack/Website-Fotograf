---
import '@fontsource-variable/archivo';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MediaOverlay from '../components/MediaOverlay.astro';
import SiteBackdrop from '../components/SiteBackdrop.astro';
interface Props { title:string; description:string; gallery?:boolean }
const {title,description,gallery=false}=Astro.props;
const bildraum = import.meta.env.PUBLIC_BILDRAUM_PREVIEW === 'true';
const immersive = ['/', '/hero-2', '/hero-2/'].includes(Astro.url.pathname);
const fullTitle=title==='Sandro Mondini – Foto & Film'?title:`${title} | Sandro Mondini`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFFDF6" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <ClientRouter fallback="none" />
  </head>
  <body class:list={{'portfolio-page':gallery}} data-bildraum={bildraum && !gallery ? 'true' : undefined}>
    {bildraum && !gallery && <SiteBackdrop />}
    <a class="skip-link" href="#inhalt">Zum Inhalt</a>
    {!immersive && <Header />}
    <main id="inhalt" tabindex="-1" transition:animate="none"><slot /></main>
    <Footer />
    <MediaOverlay />
    <script>import '../scripts/site';</script>
  </body>
</html>
